    lpg:database "conformance" ;
    lpg:scope "MATCH (i:Item) RETURN i" ;
    prov:generatedAtTime "2026-10-05T14:03:11Z"^^xsd:dateTime .

s:20261005T140311Z {

    l:Item   a lpg:Label ;       lpg:name "Item" .
    p:counts a lpg:PropertyKey ; lpg:name "counts" .
    p:empty  a lpg:PropertyKey ; lpg:name "empty" .
    p:flags  a lpg:PropertyKey ; lpg:name "flags" .
    p:name   a lpg:PropertyKey ; lpg:name "name" .
    p:tags   a lpg:PropertyKey ; lpg:name "tags" .

    e:withLists a lpg:Node ;
